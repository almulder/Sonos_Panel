<?xml version="1.0"?>
<Container version="2">
  <Name>Sonos_Panel</Name>
  <Repository>ghcr.io/almulder/sonos_panel:latest</Repository>
  <Registry>https://github.com/almulder/Sonos_Panel/pkgs/container/sonos-panel</Registry>
  <Network>host</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/almulder/Sonos_Panel/issues</Support>
  <Project>https://github.com/almulder/Sonos_Panel</Project>
  <Overview>Sonos touchscreen panel - Node/Express app controlling Sonos speakers via a browser touch UI. Requires host networking for SSDP discovery.</Overview>
  <Category>HomeAutomation:</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <TemplateURL/>
  <Icon>https://raw.githubusercontent.com/almulder/Sonos_Panel/main/public/icons/icon-512.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="AppData Config Path" Target="/app/data" Default="/mnt/user/appdata/Sonos_Panel" Mode="rw" Description="Persistent config storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/Sonos_Panel</Config>
  <Config Name="WebUI Port (for button link only)" Target="3000" Default="3000" Mode="tcp" Description="Drives the WebUI shortcut button. Must match the Application Port value below, or the button will point to the wrong place." Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="Application Port" Target="PORT" Default="3000" Mode="" Description="Sets the actual port the app listens on. Must match the WebUI Port value above." Type="Variable" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="DATA_DIR" Target="DATA_DIR" Default="/app/data" Mode="" Description="Data directory inside container" Type="Variable" Display="advanced-hide" Required="false" Mask="false">/app/data</Config>
</Container>